ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=DecisionReplay

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=DecisionReplay

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Preserve Groq extraction + Ollama wording by default.
# Set AI_PROVIDER=ollama for all-local inference without a cloud key.
# Set AI_PROVIDER=groq for all-cloud inference.
AI_PROVIDER=hybrid
# Optional override for the selected single provider (not hybrid):
AI_MODEL=
# Optional extraction-only override; leave empty for the selected mode's default.
AI_EXTRACTION_PROVIDER=
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=2048
# deterministic preserves legacy extraction/wording fallbacks, with failure records.
# New historical analysis/evaluation endpoints always return explicit AI errors.
AI_FAILURE_MODE=deterministic
# Only opt into cross-provider data transfer by setting BOTH values:
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Reuse the existing sovereign-dev Ollama runtime and installed model. No API key.
# For Docker Desktop use http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Optional local smoke-test storage. Never enable this in production.
DECISION_REPLAY_USE_IN_MEMORY=false
