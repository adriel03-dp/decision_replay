ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=DecisionReplay

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=DecisionReplay

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Core extraction, scoring and plans run with no model or cloud key.
# Opt in: ollama (local AI), groq (cloud AI), hybrid (Groq extraction + Ollama advisory).
AI_PROVIDER=none
# Optional override for the selected single provider (not hybrid):
AI_MODEL=
# Optional extraction-only override; leave empty for the selected mode's default.
AI_EXTRACTION_PROVIDER=
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=2048
# deterministic preserves legacy extraction/wording fallbacks, with failure records.
# New historical analysis/evaluation endpoints always return explicit AI errors.
AI_FAILURE_MODE=deterministic
# Only opt into cross-provider data transfer by setting BOTH values:
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Decision Replay's own Ollama runtime. No API key or duplicate model download.
# Inside this project's Compose network use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Optional local smoke-test storage. Never enable this in production.
DECISION_REPLAY_USE_IN_MEMORY=false

# Optional synchronous wording; false keeps creation/replay free of local wording delays.
# Explicit historical AI analysis and evaluation remain enabled.
AI_INTERACTIVE_WORDING=false
