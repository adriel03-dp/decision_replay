# Compose overrides. Keep Mongo/JWT/Groq secrets in ignored backend/.env.
# hybrid preserves Groq extraction + Ollama wording. ollama is fully key-free.
AI_PROVIDER=hybrid
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# Project-owned server; existing model storage is mounted read-only, never downloaded.
OLLAMA_PORT=11435
OLLAMA_MODEL_VOLUME=sovereign-dev_ollama-data
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_TIMEOUT_MS=900000
# sovereign-dev uses port 3000 and Langfuse uses 3001.
FRONTEND_PORT=3002
