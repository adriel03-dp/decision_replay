# Compose overrides. Keep Mongo/JWT/Groq secrets in ignored backend/.env.
# hybrid preserves Groq extraction + Ollama wording. ollama is fully key-free.
AI_PROVIDER=hybrid
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_TIMEOUT_MS=900000
# sovereign-dev already uses host port 3000.
FRONTEND_PORT=3001
